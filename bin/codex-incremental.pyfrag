# Override the packaged full-history walk with a per-file event cache. SQLite
# updates only changed sessions, even when the history spans many megabytes.
def scan_native_codex_sessions():
  codex_home = Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex"))
  db = None
  try:
    db = sqlite3.connect(cache_root() / "codex-native-events-v2.sqlite3", timeout=2)
    db.execute("CREATE TABLE IF NOT EXISTS sessions (path TEXT PRIMARY KEY, size INTEGER, mtime_ns INTEGER, events TEXT)")
  except sqlite3.Error:
    if db:
      db.close()
    db = None
  seen = set()
  for root in (codex_home / "sessions", codex_home / "archived_sessions"):
    if not root.exists():
      continue
    for path in root.rglob("*.jsonl"):
      try:
        stat = path.stat()
        key = str(path)
        seen.add(key)
        row = db.execute("SELECT size, mtime_ns, events FROM sessions WHERE path = ?", (key,)).fetchone() if db else None
        if row and not globals().get("SCAN_FORCE", False) and row[0] == stat.st_size and row[1] == stat.st_mtime_ns:
          events = json.loads(row[2])
        else:
          events = []
          current_model = "codex"
          with path.open(errors="replace") as handle:
            for raw in handle:
              try:
                entry = json.loads(raw)
              except Exception:
                continue
              if entry.get("type") == "turn_context":
                payload = entry.get("payload") or {}
                current_model = model_name(payload.get("model") or payload.get("model_slug") or current_model)
                continue
              payload = entry.get("payload") or entry
              if entry.get("type") == "response_item" and isinstance(payload, dict):
                payload = payload.get("payload") or payload
              if not isinstance(payload, dict) or payload.get("type") != "token_count":
                continue
              usage = (payload.get("info") or {}).get("last_token_usage") or {}
              cache_read = number(usage.get("cached_input_tokens"))
              cache_write = number(usage.get("cache_write_input_tokens"))
              input_tokens = max(0, number(usage.get("input_tokens")) - cache_read - cache_write)
              output_tokens = number(usage.get("output_tokens"))
              if input_tokens or output_tokens or cache_read or cache_write:
                events.append([local_day(entry.get("timestamp") or stat.st_mtime), key,
                               current_model, input_tokens, output_tokens, cache_read, cache_write])
          if db:
            db.execute("INSERT OR REPLACE INTO sessions VALUES (?, ?, ?, ?)",
                       (key, stat.st_size, stat.st_mtime_ns, json.dumps(events, separators=(",", ":"))))
        for event in events:
          add_usage(*event)
      except (OSError, ValueError, AttributeError, TypeError, sqlite3.Error):
        continue
  if db:
    try:
      for (key,) in db.execute("SELECT path FROM sessions"):
        if key not in seen:
          db.execute("DELETE FROM sessions WHERE path = ?", (key,))
      db.commit()
    except sqlite3.Error:
      pass
    finally:
      db.close()


def cached_codex_rpc():
  path = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local/state")) / "omarchy/agents/usage/codex.json"
  try:
    previous = json.loads(path.read_text())
  except (OSError, ValueError):
    previous = {}
  keys = ("limits", "tierLabel", "subscriptionEndsAt", "usageStatusText",
          "authHelpText", "retryAdvised")
  return {key: previous[key] for key in keys if key in previous}

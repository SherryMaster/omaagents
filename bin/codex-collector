#!/bin/bash
set -o pipefail

# Omarchy's Codex collector, run through collector-overlay for the full
# history with daily token buckets, CPAMC-routed rollouts, --local-only and
# the renewal date; then sessions, the signed-in email, and the CPAMC pool.
dir="${BASH_SOURCE[0]%/*}"
/usr/bin/python3 "$dir/collector-overlay" codex "$@" | "$dir/codex-session-enricher" "$@" | "$dir/codex-account" | "$dir/account-pool" codex "$@"

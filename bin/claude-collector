#!/bin/bash
set -o pipefail

# Omarchy's Claude collector supplies limits, plan, and today's counters,
# run through collector-overlay for --local-only and a probe backoff; the
# enricher adds the full daily history and sessions the panel's analytics
# need, and account-pool the CPAMC accounts.
dir="${BASH_SOURCE[0]%/*}"
/usr/bin/python3 "$dir/collector-overlay" claude "$@" | "$dir/claude-session-enricher" "$@" | "$dir/account-pool" claude "$@"

#!/usr/bin/python3
"""Add full per-day history and interaction-sorted sessions to a Claude record.

The packaged collector only keeps a 7-day token total per day and no
sessions, which leaves the panel's period navigator, cost view, and session
list empty for Claude. This walks the same Claude Code transcripts, caching
each file's parsed messages by size and mtime so only changed files are read.
"""

import json
import os
import re
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path


CACHE_SCHEMA = 1


def number(value):
  try:
    return int(value or 0)
  except Exception:
    return 0


def timestamp(value, fallback):
  if isinstance(value, (int, float)):
    return value / 1000 if value > 10_000_000_000 else value
  try:
    text = str(value or "")
    return datetime.fromisoformat(text[:-1] + "+00:00" if text.endswith("Z") else text).timestamp()
  except Exception:
    return fallback


def local_day(seconds):
  return datetime.fromtimestamp(seconds).strftime("%Y-%m-%d")


def title_text(value):
  if isinstance(value, list):
    value = " ".join(str(block.get("text") or "") for block in value
                     if isinstance(block, dict) and block.get("type") == "text")
  text = str(value or "").strip()
  # Slash commands, their output, and harness caveats are not what a session
  # is about.
  if not text or text.startswith(("<command-", "<local-command", "Caveat:", "[Request interrupted")):
    return ""
  text = re.sub(r"\[Image[^\]]*\]", "", text)
  text = re.sub(r"<[^>]+>", " ", text)
  text = re.sub(r"\s+", " ", text).strip()
  if not text:
    return ""
  return text[:48].rstrip() + ("…" if len(text) > 48 else "")


def empty_bucket():
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
    # Subset of cacheCreationInputTokens written with the 1-hour TTL, which
    # the API bills at 2x input instead of the 5-minute 1.25x.
    "cacheCreation1hInputTokens": 0,
  }


def scan_file(path):
  """Parse one transcript into its messages and session metadata."""
  fallback = path.stat().st_mtime
  messages = {}
  meta = {"sessionId": "", "aiTitle": "", "customTitle": "", "prompt": ""}
  with path.open(errors="replace") as handle:
    for line_number, raw in enumerate(handle, 1):
      try:
        entry = json.loads(raw)
      except Exception:
        continue
      if not isinstance(entry, dict):
        continue
      kind = entry.get("type")
      if not meta["sessionId"] and entry.get("sessionId"):
        meta["sessionId"] = str(entry["sessionId"])
      if kind == "ai-title" and entry.get("aiTitle"):
        meta["aiTitle"] = str(entry["aiTitle"])
      elif kind == "custom-title" and entry.get("customTitle"):
        meta["customTitle"] = str(entry["customTitle"])
      elif kind == "user" and not meta["prompt"] and not entry.get("isMeta") and not entry.get("isSidechain"):
        message = entry.get("message") or {}
        if isinstance(message, dict):
          meta["prompt"] = title_text(message.get("content"))
      elif kind == "assistant":
        message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
        usage = message.get("usage") or entry.get("usage")
        if not isinstance(usage, dict):
          continue
        cache_write = number(usage.get("cache_creation_input_tokens"))
        split = usage.get("cache_creation") if isinstance(usage.get("cache_creation"), dict) else {}
        cache_write_1h = min(cache_write, number(split.get("ephemeral_1h_input_tokens")))
        tokens = [
          number(usage.get("input_tokens")),
          number(usage.get("output_tokens")),
          number(usage.get("cache_read_input_tokens")),
          cache_write,
          cache_write_1h,
        ]
        if sum(tokens[:4]) <= 0:
          continue
        seconds = timestamp(entry.get("timestamp"), fallback)
        # A streamed reply repeats its usage on every content block; the
        # message id keeps it to one count, the last line carrying the totals.
        key = str(message.get("id") or entry.get("requestId") or f"{path}:{line_number}")
        messages[key] = [
          round(seconds * 1000),
          str(message.get("model") or "claude"),
          str(entry.get("effort") or ""),
        ] + tokens
  return {"meta": meta, "messages": messages, "mtime": fallback}


def write_cache(cache_dir, cache_path, payload):
  try:
    cache_dir.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".claude-session-index-", dir=cache_dir)
    try:
      with os.fdopen(fd, "w") as handle:
        json.dump(payload, handle, separators=(",", ":"))
      os.replace(temporary, cache_path)
    finally:
      if os.path.exists(temporary):
        os.unlink(temporary)
  except OSError:
    pass


def scanned_files():
  claude_dir = Path(os.environ.get("CLAUDE_CONFIG_DIR") or (Path.home() / ".claude")).expanduser()
  projects = claude_dir / "projects"
  force = "--force" in sys.argv
  cache_dir = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  cache_path = cache_dir / "claude-session-index-v1.json"
  try:
    cached = json.loads(cache_path.read_text())
    old_files = cached.get("files", {}) if cached.get("schemaVersion") == CACHE_SCHEMA else {}
  except (OSError, ValueError, AttributeError):
    old_files = {}

  new_files = {}
  changed = False
  if projects.is_dir():
    for path in projects.rglob("*.jsonl"):
      try:
        stat = path.stat()
        signature = [stat.st_size, stat.st_mtime_ns]
        key = str(path)
        cached_file = old_files.get(key) or {}
        if not force and cached_file.get("signature") == signature:
          parsed = cached_file.get("parsed")
        else:
          parsed = scan_file(path)
          changed = True
        new_files[key] = {"signature": signature, "parsed": parsed}
      except OSError:
        continue
  if changed or set(old_files) != set(new_files):
    write_cache(cache_dir, cache_path, {"schemaVersion": CACHE_SCHEMA, "files": new_files})
  return new_files


def add_tokens(bucket, tokens):
  bucket["inputTokens"] += tokens[0]
  bucket["outputTokens"] += tokens[1]
  bucket["cacheReadInputTokens"] += tokens[2]
  bucket["cacheCreationInputTokens"] += tokens[3]
  bucket["cacheCreation1hInputTokens"] += tokens[4]


def enrich(record):
  files = scanned_files()
  seen = set()
  days = {}
  sessions = {}
  # Oldest files first, so a message a resumed session copied forward is
  # credited to the conversation where it actually happened.
  for key, entry in sorted(files.items(), key=lambda item: (item[1].get("parsed") or {}).get("mtime", 0)):
    parsed = entry.get("parsed") or {}
    meta = parsed.get("meta") or {}
    session_id = meta.get("sessionId") or Path(key).stem
    session = sessions.get(session_id)
    if session is None:
      session = sessions[session_id] = {
        "id": session_id, "title": "", "prompt": "", "latestMs": 0,
        "modelUsage": {}, "modelReasoning": {},
      }
    # Subagent transcripts share their parent's session id; only the main
    # transcript's words name the session.
    if "/subagents/" not in key:
      session["title"] = meta.get("customTitle") or meta.get("aiTitle") or session["title"]
      session["prompt"] = session["prompt"] or meta.get("prompt") or ""
    for message_id, message in (parsed.get("messages") or {}).items():
      if message_id in seen:
        continue
      seen.add(message_id)
      at_ms, model, effort, tokens = message[0], message[1], message[2], message[3:]
      day = local_day(at_ms / 1000)
      history = days.setdefault(day, {"date": day, "messageCount": 0, "modelUsage": {}})
      history["messageCount"] += sum(tokens[:4])
      add_tokens(history["modelUsage"].setdefault(model, empty_bucket()), tokens)
      add_tokens(session["modelUsage"].setdefault(model, empty_bucket()), tokens)
      session["latestMs"] = max(session["latestMs"], at_ms)
      levels = session["modelReasoning"].setdefault(model, [])
      level = effort or "Not recorded"
      if level not in levels:
        levels.append(level)

  if not days:
    # Nothing on disk to improve on; keep the packaged fallbacks untouched.
    return record

  # Other sources the packaged collector merges in (pi, opencode) carry no
  # per-model daily detail. Keep their tokens visible rather than letting the
  # richer history silently undercount those days.
  for recent in record.get("recentDays") or []:
    date = str((recent or {}).get("date") or "")
    extra = number((recent or {}).get("messageCount")) - (days.get(date) or {}).get("messageCount", 0)
    if date and extra > 0:
      history = days.setdefault(date, {"date": date, "messageCount": 0, "modelUsage": {}})
      history["messageCount"] += extra

  out_sessions = []
  for session in sessions.values():
    total = sum(sum(bucket[field] for field in bucket if field != "cacheCreation1hInputTokens")
                for bucket in session["modelUsage"].values())
    if total <= 0:
      continue
    out_sessions.append({
      "id": session["id"],
      "title": session["title"] or session["prompt"] or "Session " + session["id"][:8],
      "updatedAt": datetime.fromtimestamp(session["latestMs"] / 1000, timezone.utc).isoformat(),
      "updatedAtMs": session["latestMs"],
      "totalTokens": total,
      "modelUsage": session["modelUsage"],
      "modelReasoning": session["modelReasoning"],
    })
  out_sessions.sort(key=lambda item: item["updatedAtMs"], reverse=True)

  # recentDays keeps the packaged shape but gains the per-model buckets the
  # cost view and synced snapshots need.
  record["recentDays"] = [
    dict(recent, modelUsage=(days.get(str((recent or {}).get("date") or "")) or {}).get("modelUsage", {}))
    for recent in record.get("recentDays") or []
  ]
  record["dailyUsage"] = [days[day] for day in sorted(days)]
  # The complete lightweight index: the panel filters it to the selected
  # period before showing the five latest.
  record["recentSessions"] = out_sessions
  return record


def add_months(moment, months):
  month = moment.month - 1 + months
  year, month = moment.year + month // 12, month % 12 + 1
  # Stripe pins a renewal that falls past a short month's end to its last day.
  days = [31, 29 if year % 4 == 0 and (year % 100 or year % 400 == 0) else 28,
          31, 30, 31, 30, 31, 31, 30, 31, 30, 31][month - 1]
  return moment.replace(year=year, month=month, day=min(moment.day, days))


def read_account():
  """The signed-in account Claude Code caches beside its settings."""
  config = os.environ.get("CLAUDE_CONFIG_DIR")
  path = Path(config).expanduser() / ".claude.json" if config else Path.home() / ".claude.json"
  try:
    account = json.loads(path.read_text()).get("oauthAccount")
  except (OSError, ValueError, AttributeError):
    return {}
  return account if isinstance(account, dict) else {}


def subscription_ends_at(account):
  """Next renewal of a paid Claude plan.

  Claude Code stores when the subscription began but not its renewal date, so
  this assumes monthly billing anchored on the start date — the same anchor
  Stripe uses.
  """
  if "subscription" not in str(account.get("billingType") or ""):
    return ""
  started = timestamp(account.get("subscriptionCreatedAt"), 0)
  if started <= 0:
    return ""
  start = datetime.fromtimestamp(started, timezone.utc)
  now = datetime.now(timezone.utc)
  months = max(1, (now.year - start.year) * 12 + now.month - start.month)
  renewal = add_months(start, months)
  while renewal <= now:
    months += 1
    renewal = add_months(start, months)
  return renewal.isoformat()


record = json.load(sys.stdin)
record = enrich(record)
account = read_account()
ends_at = subscription_ends_at(account)
if ends_at:
  record["subscriptionEndsAt"] = ends_at
if account.get("emailAddress"):
  record["accountLabel"] = str(account["emailAddress"])
json.dump(record, sys.stdout, separators=(",", ":"))
sys.stdout.write("\n")
